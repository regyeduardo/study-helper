# ── DeepSeek ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_TEXT_MODEL="deepseek-v4-flash"
DEBUG_OUTPUT=false

# ── Transcrição — OpenAI Audio API (opcional) ──────────────────────────────
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_AUDIO_MODEL="whisper-1"
TRANSCRIPTION_PROVIDER="local" # local | openai

# ── Transcrição — local (Whisper) ──────────────────────────────────────────
WHISPER_MODEL="small"
WHISPER_CACHE_DIR="/data/whisper"

# ── Banco de dados (Postgres do host) ─────────────────────────────────────
DATABASE_URL="postgresql+psycopg://root:root@host.docker.internal:5432/study-helper"

# ── Navegador da legenda do YouTube ───────────────────────────────────────
BROWSER_SERVICE_URL="http://browser:8080"

# ── Modo de teste ─────────────────────────────────────────────────────────
# Com TEST_MODE=true a API lê respostas de testdata/fixtures em vez de chamar
# a DeepSeek, o yt-dlp e o trafilatura. Nunca use true em produção.
TEST_MODE=false

TIMEZONE="America/Sao_Paulo"

VITE_PORT=5180
VITE_GOOGLE_CLIENT_ID=""
