# ── DeepSeek ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_TEXT_MODEL="deepseek-v4-flash"
DEBUG_OUTPUT=false

# ── Transcrição — OpenAI Audio API (opcional) ──────────────────────────────
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_AUDIO_MODEL="whisper-1"
TRANSCRIPTION_PROVIDER="local" # local | openai

# ── Transcrição — local (Whisper) ──────────────────────────────────────────
WHISPER_MODEL="small"
WHISPER_CACHE_DIR="/data/whisper"

# ── Banco de dados (SQLite) ───────────────────────────────────────────────
DATABASE_URL="sqlite:////data/study-helper.db"

# ── Modo de teste ─────────────────────────────────────────────────────────
# Com TEST_MODE=true a API lê respostas de testdata/fixtures em vez de chamar
# a DeepSeek, o yt-dlp e o trafilatura. Nunca use true em produção.
TEST_MODE=false
